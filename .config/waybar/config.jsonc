{
    "layer": "top",
    "position": "top",
    "height": 32, // roughly equivalent to 24pt at 96 DPI
    "spacing": 0,

    "modules-left": [
        "sway/workspaces",
        "sway/window"
    ],
    "modules-right": [
        "pulseaudio",
        "custom/sep",
        "memory",
        "custom/sep",
        "cpu",
        "custom/sep",
        "network#wlan",
        "network#eth",
        "custom/sep",
        "battery",
        "custom/sep",
        "tray",
        "custom/sep",
        "clock"
    ],

    // Emulates Polybar's `separator = |`
    "custom/sep": {
        "format": "|",
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/window": {
        "max-length": 60
    },

    "pulseaudio": {
        "format": "<span color='#fabd2f'>VOL</span> {volume}%",
        "format-muted": "<span color='#928374'>muted</span>",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },

    "memory": {
        "interval": 2,
        "format": "<span color='#fabd2f'>RAM</span> {used:0.1f}G"
    },

    "cpu": {
        "interval": 2,
        "format": "<span color='#fabd2f'>CPU</span> {usage:2}%"
    },

    "network#wlan": {
        "interface": "wl*",
        "interval": 5,
        "format-wifi": "<span color='#fabd2f'>Wifi</span> {essid} {signalStrength}%",
        "format-disconnected": "<span color='#928374'>{ifname} disconnected</span>"
    },

    "network#eth": {
        "interface": "en*",
        "interval": 5,
        "format-ethernet": " | <span color='#fabd2f'>{ifname} {ipaddr}</span>",
        "format-disconnected": ""
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "interval": 5,
        "format": "<span color='#fabd2f'>Discharging</span> {capacity}%",
        "format-charging": "<span color='#fabd2f'>Charging</span> {capacity}%",
        "format-plugged": "<span color='#fabd2f'>Charging</span> {capacity}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 16
    },

    "clock": {
        "interval": 1,
        "format": "{:%l:%M %p}",
        "format-alt": "{:%Y-%m-%d %l:%M:%S %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    }
}
