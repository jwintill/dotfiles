#!/bin/bash

PIDFILE="/tmp/screenrecord.pid"
OUTDIR="/home/$USER/Videos/Screenrecords"
mkdir -p "$OUTDIR"

if [ -f "$PIDFILE" ] && ps -p "$(cat "$PIDFILE")" > /dev/null 2>&1; then
  kill -INT "$(cat "$PIDFILE")"
  rm "$PIDFILE"
  notify-send "Screen recording stopped"
else
  rm -f "$PIDFILE"
  ffmpeg -y -f x11grab -framerate 30 -i "$DISPLAY" \
    -f pulse -i alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source \
    -c:v libx264 -preset ultrafast -crf 23 \
    -c:a aac \
    "$OUTDIR/recording_$(date +%Y%m%d_%H%M%S).mp4" \
    > /tmp/screenrecord.log 2>&1 &
  echo $! > "$PIDFILE"
  notify-send "Screen recording started"
fi
